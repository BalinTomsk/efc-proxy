# cproxy-firewall.service - reapply the cproxy access allowlist after every boot (iptables rules are not persistent).
# Install: copy to /etc/systemd/system/, copy cproxy-firewall.sh to /usr/local/sbin/ (chmod 0755),
# create /usr/local/etc/cproxy-firewall.allow, then: systemctl daemon-reload && systemctl enable --now cproxy-firewall
[Unit]
Description=cproxy access allowlist (DOCKER-USER)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Host ports open to every address: 443 is cproxy's MCP TLS listener (0.20.0), which checks its own keys;
# 8443 is mproxy, the Android app's HTTPS edge (efc-mobilr-proxy), which requires a signed-in token.
# Port 80 is NOT here -- it stays restricted to the allow file.
Environment=PUBLIC_TCP_PORTS=443,8443
ExecStart=/usr/local/sbin/cproxy-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
