# cproxy configuration (all optional; safe defaults shown). Copy to .env for local runs.
# Do NOT commit a real .env.

# Bind
CPROXY_LISTEN_ADDR=0.0.0.0
CPROXY_LISTEN_PORT=8080

# docapi upstream (scheme://host:port). In production this is docapi's DigitalOcean VPC
# address (a private, non-public IP) — see CLAUDE.md -> Reachability. The default below is a
# neutral localhost placeholder for local development; set the real address here / via -e.
CPROXY_DOCAPI_UPSTREAM=http://127.0.0.1:8080

# Only requests under this path prefix are forwarded to docapi; everything else 404s.
CPROXY_ROUTE_PREFIX=/api/

# Optional edge hardening (recommended when the proxy is public-facing):
#   CPROXY_API_KEY=change-me            # require header  X-API-Key: change-me
#   CPROXY_ALLOWED_METHODS=GET,HEAD     # read-only; omit or set ALL to allow every method

# Day-key store: an ADDITIONAL, orthogonal gate that applies to every POST and PATCH request
# regardless of CPROXY_API_KEY (POST/PATCH must also be in CPROXY_ALLOWED_METHODS or they never reach
# this check). Path to a read-only SQLite database (day_keys(stamp TEXT PRIMARY KEY, guid TEXT NOT
# NULL), one row per calendar DATE — the day-of-year schema was retired in 0.9.0) holding one rotating
# credential per day; the caller presents the current UTC day's guid, inside the JWT below or in the
# legacy X-Day-Guid header (a 1-day grace window on either side is accepted).
# Generated out-of-band, never from source — see CLAUDE.md -> "Day-key store".
# Empty/unset means every gated request always answers 500 (fail closed), even if
# CPROXY_ALLOWED_METHODS permits the method.
# CPROXY_DAYKEY_DB=/etc/cproxy/daykeys.sqlite

# Paths that require the day-key on EVERY method, GET included — the way to put a READ behind the
# rotating credential. Defaults to /news/default (the assembled news home page: expensive for docapi
# to build, and no reason to serve it to anonymous scrapers just because it is a GET). Matching is on
# the path tail, so the entry works at any route prefix; casing and a trailing slash do not matter,
# and anything nested under a gated path is gated too.
# Use NONE to disable this arm — an EMPTY value reads as "unset" and leaves the default in place.
# The POST/PATCH gate above is unaffected by this setting either way.
# CPROXY_DAYKEY_PATHS=/news/default

# Datacenter / cloud-provider IP blocking. Mirrors the ASP.NET frontend's dbo.CloudProviderIpRange:
# real anglers come from residential/mobile ISPs, so sustained traffic from AWS/GCP/Azure/Oracle/
# DigitalOcean/Alibaba/... is bots and scrapers. A REST call from one of those ranges is answered
# with an opaque 500 (same shape as a failed day-key, so probing reveals nothing).
# Empty path = the whole feature is off: no blocking, and the refresh thread never starts.
# CPROXY_CLOUDRANGE_DB=/etc/cproxy/cloudranges.sqlite
#
# Kill-switch, same true/false/0 convention as the frontend's BlockCloudProviderIps. false keeps the
# database and the refresh running but stops refusing anything - the fastest rollback if a bad range
# starts turning real callers away.
# CPROXY_BLOCK_CLOUD_IPS=true
#
# The refresher fetches each provider's published feed over HTTPS and rewrites the database, keeping
# any manual `disabled = 1` override per (provider, cidr). A feed that fails leaves ITS OWN rows
# intact; if every feed fails the database is not touched at all. Default 336h = fortnightly.
# CPROXY_CLOUDRANGE_REFRESH_HOURS=336
# CPROXY_CLOUDRANGE_REFRESH_ON_START=false   # true = fetch once at boot instead of waiting an interval
# CPROXY_CLOUDRANGE_FETCH_TIMEOUT_SECONDS=60
# CPROXY_CLOUDRANGE_PROVIDERS=AWS,GCP,Azure,Oracle,DigitalOcean,Alibaba,Linode,Vultr,Hetzner,OVH,Scaleway,Tencent
#   Unset = all of the above. Use NONE to stop refreshing while STILL blocking what is already
#   stored (an empty value reads as unset - see CPROXY_LOG_DIR for why).
#
# Addresses never blocked whatever the ranges say. EXTERNAL_ADMIN and EXTERNAL_FRONTEND are exempt
# automatically and do not need repeating here - the portal's own host lives at a hosting provider,
# so without that exemption this block would take the site offline.
# CPROXY_CLOUDRANGE_EXEMPT_IPS=

# Upstream timeouts (milliseconds)
CPROXY_CONNECT_TIMEOUT_MS=3000
CPROXY_READ_TIMEOUT_MS=10000

# Request bodies larger than this are rejected with 413 before any handler runs (bytes).
CPROXY_MAX_PAYLOAD_BYTES=1048576

# Upstream circuit breaker: after N consecutive transport failures the proxy stops dialing the
# upstream and answers 502 immediately for COOLDOWN ms, then lets one probe through. Set the
# threshold to 0 to disable. /health/ready reports 503 while it is open.
CPROXY_BREAKER_THRESHOLD=5
CPROXY_BREAKER_COOLDOWN_MS=5000

# Retry an idempotent request (GET/HEAD/OPTIONS) once when the upstream call fails at the transport
# level - mainly to hide a pooled keep-alive connection the upstream closed while idle. 0 = off.
CPROXY_UPSTREAM_RETRY=1

# Logging: JSON to console (docker logs) AND a daily-rolling file <dir>/cproxy.log, keeping
# CPROXY_LOG_MAX_HISTORY days. The Docker image defaults CPROXY_LOG_DIR to /var/log/cproxy; mount a
# persistent volume there in production.
# Use NONE for console-only — an EMPTY value reads as "unset" and falls back to the default (logs),
# so `-e CPROXY_LOG_DIR=` keeps writing files. Same idiom as CPROXY_DAYKEY_PATHS=NONE above.
CPROXY_LOG_DIR=logs
CPROXY_LOG_MAX_HISTORY=7

# Encrypted config (optional). cproxy can read an extra dotenv file and decrypt any enc:v1: values
# with a 32-byte master key (AES-256-GCM), the same scheme as secret/Protect-Env.ps1 / the platform
# SecretCodec. In production the .env and key live on a mounted volume; a real process env var always
# wins over a value from this file. A value marked enc:v1: with no/wrong key is a fatal startup error.
# CPROXY_DOTENV_PATH=/etc/cproxy/.env         # extra dotenv read at startup
# FF_MASTER_KEY_FILE=/etc/cproxy/master.key   # key file (hex or base64), preferred over FF_MASTER_KEY
# EXTERNAL_ADMIN=...        # secret; store enc:v1: in .env via Protect-Env.ps1 (-Encrypt list)
# EXTERNAL_FRONTEND=...     # secret; store enc:v1: in .env via Protect-Env.ps1 (-Encrypt list)
