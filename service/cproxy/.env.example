# cproxy configuration (all optional; safe defaults shown). Copy to .env for local runs.
# Do NOT commit a real .env.

# Bind
CPROXY_LISTEN_ADDR=0.0.0.0
CPROXY_LISTEN_PORT=8080

# docapi upstream (scheme://host:port). In production this is docapi's DigitalOcean VPC
# address (a private, non-public IP) — see CLAUDE.md -> Reachability. The default below is a
# neutral localhost placeholder for local development; set the real address here / via -e.
CPROXY_DOCAPI_UPSTREAM=http://127.0.0.1:8080

# Only requests under this path prefix are forwarded to docapi; everything else 404s.
CPROXY_ROUTE_PREFIX=/api/

# Optional edge hardening (recommended when the proxy is public-facing):
#   CPROXY_API_KEY=change-me            # require header  X-API-Key: change-me
#   CPROXY_ALLOWED_METHODS=GET,HEAD     # read-only; omit or set ALL to allow every method

# Upstream timeouts (milliseconds)
CPROXY_CONNECT_TIMEOUT_MS=3000
CPROXY_READ_TIMEOUT_MS=10000

# Logging: JSON to console (docker logs) AND a daily-rolling file <dir>/cproxy.log, keeping
# CPROXY_LOG_MAX_HISTORY days. The Docker image defaults CPROXY_LOG_DIR to /var/log/cproxy; mount a
# persistent volume there in production. Set CPROXY_LOG_DIR="" for console-only.
CPROXY_LOG_DIR=logs
CPROXY_LOG_MAX_HISTORY=7
